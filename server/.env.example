# ---- Core ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/al-noor-books
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Where the React app is served from (comma-separate several origins if needed)
CLIENT_URL=http://localhost:5173
# lax works when the site and API share one domain (recommended). Use "none" only for split hosting over HTTPS.
COOKIE_SAMESITE=lax

# ---- Admin (single account) ----
ADMIN_EMAIL=admin@example.com
# Generate with: npm run hash-password -- "your-long-password"   (keep the single quotes!)
ADMIN_PASSWORD_HASH='$2a$12$replace-with-generated-bcrypt-hash'

# ---- Cloudinary (required in production) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Owner order emails (Nodemailer / SMTP) - server-side only, never exposed to the React app ----
# Leave empty in development to just print new orders in the server console.
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (SMTP_SECURE=false), 465 = SSL (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Gmail: use an App Password (needs 2-Step Verification), not your normal password
SMTP_PASS=
# Optional. Defaults to SMTP_USER. Example: Al Noor Books <orders@yourdomain.com>
SMTP_FROM=
# Where new-order emails go (comma-separate for several)
OWNER_EMAIL=
